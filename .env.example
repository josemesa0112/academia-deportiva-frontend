# Copiar a .env.local para desarrollo. NO crear un .env commiteado:
# Vite tambien lee los .env al construir para produccion, asi que un valor
# equivocado en el repo se hornea en el bundle de Vercel y rompe la app.

# URL del backend. Si se omite, se usa el API desplegado en Render
# (ver el valor por defecto en src/lib/api.js).
VITE_API_URL=http://localhost:3000